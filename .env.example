# Runtime-only configuration. Replace placeholders; do not store credentials.
INTEGRATIONS_API_HOST=0.0.0.0
INTEGRATIONS_API_ENV=production
# PORT is assigned by the PaaS; optional INTEGRATIONS_API_PORT overrides it.
INTEGRATIONS_API_REGISTRY_PATH=/app/infra/api/external_app_registry.ts
INTEGRATIONS_API_AUTH_ISSUER=https://solo-web.example
INTEGRATIONS_API_AUTH_PUBLIC_KEY=REPLACE_WITH_PEM_RSA_PUBLIC_KEY
INTEGRATIONS_API_AUTH_SUBJECTS=REPLACE_WITH_ALLOWED_OIDC_OWNER_SUBJECT
INTEGRATIONS_API_CORS_ORIGINS=https://solo-web.example
